#!/bin/sh
set -eu
RUNTIME=/var/packages/syno-intel-gpu-top/target
# The CLI may be installed before the i915 module/device is available, and is
# also useful for later hardware changes.  Create its fixed, package-owned
# PATH shim on both K4 and K5; a PMU-enabled i915 backport can provide
# telemetry on K4. The utility reports an error at execution time if the
# required Intel DRM/PMU interface is absent.
"$RUNTIME/bin/helper/intel-gpu-top-root" --install-path || echo "Warning: PATH integration will be retried on package update." >&2
